# Terraform variables for dev environment
# Generated automatically - modify as needed

# AWS region for resource deployment
region = "ap-southeast-1"

# Name of the S3 bucket for media
media_bucket_name = "matrimonial-app-media"

# Repository URL for the frontend application
frontend_repo = "https://github.com/my-org/matrimonial-frontend"

# OAuth token for Amplify to access the repository
github_oauth_token = null

# Name of the database
db_name = "matrimonial_db"

# Username for the database
db_username = "db_user"
