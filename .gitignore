# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
!terraform.tfvars.json

# Override files — used for local backend, not for CI
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file (commit this if you want reproducible provider versions)
# .terraform.lock.hcl

# Terraform plan output
*.tfplan
tfplan
